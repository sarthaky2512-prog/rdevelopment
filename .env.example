# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Maps Platform browser key (Vite client-side)
VITE_GOOGLE_MAPS_API_KEY=""

# Configurable public website domain for SEO canonical URLs
VITE_SITE_URL="https://rdevelopmentgroup.com"

# Optional SMTP email notification settings for inquiry alerts to support@rdevelopmentgroup.com
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
NOTIFY_EMAIL="support@rdevelopmentgroup.com"
